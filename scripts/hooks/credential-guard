#!/usr/bin/env sh
# Credential Guard — pre-commit hook
# ----------------------------------------------------------------------------
# Purpose : Scan staged files for known secret formats and hard-block the
#           commit when a match is found. Designed for the Nexhire Core
#           modular monolith (.NET 10 / C# 14) and any other git repo.
#
# Mode    : READ-ONLY. This script MUST NEVER:
#             - write to the working tree
#             - run `git checkout`, `git reset`, `git commit --amend`,
#               or modify refs in any way
#             - call sed -i, rm, mv, cp on tracked files
#             - reach the network or invoke external APIs
#           It may only: read git state, grep content, print to
#           stdout/stderr, and exit.
#
# Exit codes
#           0  clean
#           1  secret(s) detected, commit blocked
#           2  internal error (fail-open with a loud warning)
#           3  self-test failed
#
# Usage    : invoked automatically by git as scripts/hooks/credential-guard
#           or manually with `./scripts/hooks/credential-guard --self-test`.
# ----------------------------------------------------------------------------

# Disable pathname expansion so regex metacharacters in our patterns are
# never interpreted as globs by the shell.
set -f
# Treat unset variables as errors. (Fail-open on the few unavoidable cases.)
set -u

# ----------------------------------------------------------------------------
# Paths
# ----------------------------------------------------------------------------
SELF_PATH=$0
# Resolve symlinks (git does not execute the hook via a symlink, but be safe).
while [ -L "$SELF_PATH" ]; do
    LINK=$(readlink "$SELF_PATH" 2>/dev/null || printf '')
    case "$LINK" in
        /*) SELF_PATH=$LINK ;;
        *)  SELF_PATH=$(dirname "$SELF_PATH")/$LINK ;;
    esac
done
SCRIPT_DIR=$(cd "$(dirname "$SELF_PATH")" 2>/dev/null && pwd || printf '.')
ALLOWLIST_FILE=$SCRIPT_DIR/credential-guard.allowlist

TMPDIR_FALLBACK=${TMPDIR:-/tmp}
PATTERNS_TMP=$TMPDIR_FALLBACK/credential-guard.$$.patterns
ALLOW_TMP=$TMPDIR_FALLBACK/credential-guard.$$.allow
trap 'rm -f "$PATTERNS_TMP" "$ALLOW_TMP"' EXIT INT TERM

# ----------------------------------------------------------------------------
# TTY colors (gracefully degrade on dumb terminals and CI logs)
# ----------------------------------------------------------------------------
if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ -n "${TERM:-}" ] && [ "${TERM:-}" != "dumb" ]; then
    C_RED=$(tput setaf 1 2>/dev/null || printf '')
    C_GREEN=$(tput setaf 2 2>/dev/null || printf '')
    C_YELLOW=$(tput setaf 3 2>/dev/null || printf '')
    C_CYAN=$(tput setaf 6 2>/dev/null || printf '')
    C_BOLD=$(tput bold 2>/dev/null || printf '')
    C_DIM=$(tput dim 2>/dev/null || printf '')
    C_RESET=$(tput sgr0 2>/dev/null || printf '')
else
    C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''; C_BOLD=''; C_DIM=''; C_RESET=''
fi

# ----------------------------------------------------------------------------
# Patterns — "label:::POSIX-ERE"
# Add new patterns at the bottom. Keep them tight: a false positive in a
# blocking gate is far worse than a false negative. Avoid `(?i)` — it is
# a GNU extension and breaks on BSD/macOS. List uppercase variants as
# separate labels if needed.
# ----------------------------------------------------------------------------
cat > "$PATTERNS_TMP" <<'PATTERNS_EOF'
anthropic_key:::sk-ant-(api03-)?[A-Za-z0-9_-]{20,}
openai_key:::sk-[A-Za-z0-9]{40,}|sk-proj-[A-Za-z0-9_-]{40,}
github_pat:::ghp_[A-Za-z0-9]{36}
github_oauth:::gho_[A-Za-z0-9]{36}
github_app:::ghu_[A-Za-z0-9]{36}
github_server:::ghs_[A-Za-z0-9]{36}
github_fine_grained_pat:::github_pat_[A-Za-z0-9_]{82}
aws_access_key:::AKIA[0-9A-Z]{16}
aws_secret_assignment:::aws(.{0,20})?(secret|sk)[_-]?key[^A-Za-z0-9]{1,5}[A-Za-z0-9/++=]{40}
azure_storage_conn:::DefaultEndpointsProtocol=https;AccountName=[A-Za-z0-9]+;AccountKey=[A-Za-z0-9/++=]{60,}
slack_token:::xox[abprs]-[A-Za-z0-9-]{10,}
stripe_key:::(sk|pk|rk)_(test|live)_[A-Za-z0-9]{24,}
google_api_key:::AIza[0-9A-Za-z_-]{35,}
heroku_api_key:::[hH]eroku[A-Za-z0-9_ -]{0,5}[A-Za-z0-9]{36}
sendgrid_api_key:::SG[.][A-Za-z0-9_-]{20,30}[.][A-Za-z0-9_-]{40,50}
mailgun_api_key:::key-[a-f0-9]{32}
jwt:::eyJ[A-Za-z0-9_-]{10,}[.]eyJ[A-Za-z0-9_-]{10,}[.][A-Za-z0-9_-]{10,}
private_key_block:::-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----
password_assignment_lc:::(password|passwd|pwd)[[:space:]]*[:=][[:space:]]*['"][^'\"[:space:]]{6,}['"]
password_assignment_uc:::(PASSWORD|PASSWD|PWD)[[:space:]]*[:=][[:space:]]*['"][^'\"[:space:]]{6,}['"]
secret_assignment_lc:::(api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token|bearer)[[:space:]]*[:=][[:space:]]*['"][A-Za-z0-9_/++=-]{16,}['"]
secret_assignment_uc:::(API[_-]?KEY|SECRET[_-]?KEY|AUTH[_-]?TOKEN|ACCESS[_-]?TOKEN|BEARER)[[:space:]]*[:=][[:space:]]*['"][A-Za-z0-9_/++=-]{16,}['"]
secret_assignment_camel:::(api[Kk]ey|secret[Kk]ey|auth[Tt]oken|access[Tt]oken|[Bb]earer)[[:space:]]*[:=][[:space:]]*['"][A-Za-z0-9_/++=-]{16,}['"]
PATTERNS_EOF

# Build a single combined regex (alternation) for the fast pre-screen.
COMBINED_RE=$(awk -F':::' 'NF>=2 && $2!="" {print $2}' "$PATTERNS_TMP" | paste -sd'|' -)

# ----------------------------------------------------------------------------
# Allowlist state (populated by load_allowlist)
# ----------------------------------------------------------------------------
ALLOW_STRINGS=''
ALLOW_REGEXES=''
ALLOW_PATHS=''

# ----------------------------------------------------------------------------
# mask <secret>
#   Reduce to first 4 + "..." + last 4. Never print the full value, even
#   in our own report — protects CI logs.
# ----------------------------------------------------------------------------
mask() {
    s=$1
    n=${#s}
    if [ "$n" -le 12 ]; then
        printf '***\n'
        return
    fi
    head=$(printf '%s' "$s" | cut -c1-4)
    tail_start=$((n - 3))
    tail=$(printf '%s' "$s" | cut -c${tail_start}-)
    printf '%s...%s\n' "$head" "$tail"
}

# ----------------------------------------------------------------------------
# match_line <line>
#   Prints the first matching pattern label, or empty if no match.
#   Uses awk to safely iterate patterns with a regex match. The test line
#   is passed via ENVIRON so it survives special characters.
# ----------------------------------------------------------------------------
match_line() {
    line=$1
    [ -z "$line" ] && return 0
    CRED_GUARD_TEST_LINE=$line awk -F':::' '
        NF >= 2 && $2 != "" {
            re = $2
            test = ENVIRON["CRED_GUARD_TEST_LINE"]
            if (test ~ re) {
                print $1
                exit
            }
        }
    ' "$PATTERNS_TMP"
}

# ----------------------------------------------------------------------------
# extract_secret <line> <pattern_ere>
#   Pull the matched substring out of <line> for masked display.
#   Falls back to the full trimmed line if extraction fails.
# ----------------------------------------------------------------------------
extract_secret() {
    line=$1
    re=$2
    # Use grep -oE to print just the match. If the line contains the
    # separator characters we use the whole-line approach with awk instead.
    match=$(printf '%s' "$line" | grep -oE "$re" 2>/dev/null | head -n 1)
    if [ -n "$match" ]; then
        printf '%s' "$match"
    else
        # Fallback: print first 40 chars
        printf '%s' "$line" | cut -c1-40
    fi
}

# ----------------------------------------------------------------------------
# load_allowlist
#   Populate ALLOW_STRINGS, ALLOW_REGEXES, ALLOW_PATHS from the allowlist
#   file. Missing file is not an error — we just allowlist nothing.
# ----------------------------------------------------------------------------
load_allowlist() {
    ALLOW_STRINGS=''
    ALLOW_REGEXES=''
    ALLOW_PATHS=''
    [ -f "$ALLOWLIST_FILE" ] || return 0

    ALLOW_STRINGS_FILE=$ALLOW_TMP.strings
    ALLOW_REGEX_FILE=$ALLOW_TMP.regex
    ALLOW_PATHS_FILE=$ALLOW_TMP.paths
    : > "$ALLOW_STRINGS_FILE"
    : > "$ALLOW_REGEX_FILE"
    : > "$ALLOW_PATHS_FILE"

    while IFS= read -r raw || [ -n "$raw" ]; do
        # Strip leading/trailing whitespace
        line=$(printf '%s' "$raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        # Skip blanks and comments
        case $line in ''|'#'*) continue ;; esac
        case $line in
            string:*)
                v=${line#string:}
                printf '%s\n' "$v" >> "$ALLOW_STRINGS_FILE"
                ;;
            regex:*)
                v=${line#regex:}
                # Strip optional surrounding slashes for the user's convenience.
                case $v in
                    /*/) v=$(printf '%s' "$v" | sed 's#^/##; s#/$##') ;;
                esac
                printf '%s\n' "$v" >> "$ALLOW_REGEX_FILE"
                ;;
            path:*)
                v=${line#path:}
                printf '%s\n' "$v" >> "$ALLOW_PATHS_FILE"
                ;;
            *)
                # Unknown directive — ignore silently. Allowlist is best-effort.
                ;;
        esac
    done < "$ALLOWLIST_FILE"

    ALLOW_STRINGS=$(cat "$ALLOW_STRINGS_FILE" 2>/dev/null || printf '')
    ALLOW_REGEXES=$(cat "$ALLOW_REGEX_FILE" 2>/dev/null || printf '')
    ALLOW_PATHS=$(cat "$ALLOW_PATHS_FILE" 2>/dev/null || printf '')
}

# ----------------------------------------------------------------------------
# glob_to_regex <glob>
#   Convert a shell-style glob to a POSIX ERE suitable for grep -E.
#   Supports:
#       **/X    (any path prefix, then X)
#       X/**    (X, then any path suffix)
#       **/X/** (X anywhere in the path)
#       *       (any chars within a single path component)
#       ?       (any single char)
#       .       (literal dot)
#   Examples:
#       docs/**/*.md        -> ^docs/((.*/)?)[^/]*[.]md$
#       **/samples/**       -> ^((.*/)?)samples/(.*)?$
#       **/*.example.json   -> ^((.*/)?)[^/]*[.]example[.]json$
#       tests/**            -> ^tests/(.*)?$
# ----------------------------------------------------------------------------
glob_to_regex() {
    printf '%s' "$1" | sed \
        -e 's#\*\*\/#@DS_SLASH@#g' \
        -e 's#/\*\*#/@DS_TRAIL@#g' \
        -e 's#\*\*#@DOUBLE_STAR@#g' \
        -e 's#?#.#g' \
        -e 's#[.]#[.]#g' \
        -e 's#\*#[^/]*#g' \
        -e 's#@DS_SLASH@#((.*/)?)#g' \
        -e 's#@DS_TRAIL@#(.*)?#g' \
        -e 's#@DOUBLE_STAR@#.*#g'
}

# ----------------------------------------------------------------------------
# path_allowlisted <file>
#   Returns 0 if the file matches any allowlist path: rule.
# ----------------------------------------------------------------------------
path_allowlisted() {
    file=$1
    [ -z "$ALLOW_PATHS" ] && return 1
    old_ifs=$IFS
    IFS='
'
    for pat in $ALLOW_PATHS; do
        IFS=$old_ifs
        [ -z "$pat" ] && continue
        re=$(glob_to_regex "$pat")
        if printf '%s' "$file" | grep -E -e "^${re}\$" >/dev/null 2>&1; then
            IFS=$old_ifs
            return 0
        fi
    done
    IFS=$old_ifs
    return 1
}

# ----------------------------------------------------------------------------
# content_allowlisted <line>
#   Returns 0 if the line is allowed by a string: or regex: rule.
# ----------------------------------------------------------------------------
content_allowlisted() {
    line=$1
    # Exact-string substring rules
    if [ -n "$ALLOW_STRINGS" ]; then
        old_ifs=$IFS
        IFS='
'
        for s in $ALLOW_STRINGS; do
            IFS=$old_ifs
            [ -z "$s" ] && continue
            case $line in
                *"$s"*) IFS=$old_ifs; return 0 ;;
            esac
        done
        IFS=$old_ifs
    fi
    # Regex rules
    if [ -n "$ALLOW_REGEXES" ]; then
        old_ifs=$IFS
        IFS='
'
        for r in $ALLOW_REGEXES; do
            IFS=$old_ifs
            [ -z "$r" ] && continue
            if printf '%s' "$line" | grep -E -e "$r" >/dev/null 2>&1; then
                IFS=$old_ifs; return 0
            fi
        done
        IFS=$old_ifs
    fi
    return 1
}

# ----------------------------------------------------------------------------
# path_blocked <file>
#   Returns 0 if a staged file path looks dangerous on its face, even
#   before we look at contents.
# ----------------------------------------------------------------------------
path_blocked() {
    file=$1
    case $file in
        *.pem|*.key|*.pfx) return 0 ;;
        .env|.env.*) return 0 ;;
        secrets|secrets/*) return 0 ;;
    esac
    return 1
}

# ----------------------------------------------------------------------------
# scan_file <staged_path>
#   Prints hits in the form:  line_no<TAB>pattern<TAB>matched_substring
#   Empty output means clean.
# ----------------------------------------------------------------------------
scan_file() {
    file=$1

    # Get the staged content via `git show :<path>`. This reads the index
    # version, never touches the working tree, and never produces side
    # effects. Safe under our read-only contract.
    staged_content=$(git show ":$file" 2>/dev/null) || return 0
    [ -z "$staged_content" ] && return 0

    # Per-line scan. We use awk so we can track line numbers cleanly.
    printf '%s\n' "$staged_content" | awk -v re="$COMBINED_RE" -v pats="$PATTERNS_TMP" '
        BEGIN {
            # Build the pattern table once
            i = 0
            while ((getline line < pats) > 0) {
                n = split(line, parts, ":::")
                if (n >= 2 && parts[2] != "") {
                    i++
                    labels[i] = parts[1]
                    regexes[i] = parts[2]
                }
            }
            close(pats)
        }
        {
            if (!match($0, re)) next
            # Find which pattern matched
            for (j = 1; j <= i; j++) {
                if (match($0, regexes[j])) {
                    printf("%d\t%s\t%s\n", NR, labels[j], substr($0, RSTART, RLENGTH))
                    break
                }
            }
        }
    '
}

# ----------------------------------------------------------------------------
# report_hits <file> <hits>
#   Pretty-prints the red box and per-hit details.
# ----------------------------------------------------------------------------
report_hits() {
    file=$1
    hits=$2
    count=$(printf '%s\n' "$hits" | grep -c . 2>/dev/null || printf '0')
    [ "$count" -eq 0 ] && return 0
    printf '%s' "${C_BOLD}${C_RED}"
    printf '+--------------------------------------------------------------------+\n'
    printf '|  Credential Guard  --  COMMIT BLOCKED                              |\n'
    printf '|  %d potential secret(s) in %s\n' "$count" "$file"
    printf '+--------------------------------------------------------------------+\n'
    printf '%s' "$C_RESET"
    i=0
    printf '%s\n' "$hits" | while IFS=$(printf '\t') read -r lineno label matched; do
        [ -z "$lineno" ] && continue
        i=$((i + 1))
        masked=$(mask "$matched")
        printf '\n'
        printf '%s[%d/%d]%s %s%s%s\n' "$C_BOLD" "$i" "$count" "$C_RESET" "$C_YELLOW" "$label" "$C_RESET"
        printf '    %sfile:%s  %s\n' "$C_DIM" "$C_RESET" "$file"
        printf '    %sline:%s  %s\n' "$C_DIM" "$C_RESET" "$lineno"
        printf '    %smatch:%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_RED" "$masked" "$C_RESET"
    done
    printf '\n'
    printf '%sRemediation%s\n' "$C_BOLD" "$C_RESET"
    printf '  1. Remove the secret from the file and use env / user-secrets / Key Vault.\n'
    printf '  2. Rotate the credential at the provider (treat the old value as compromised).\n'
    printf '  3. Scrub commit history: git filter-repo --invert-paths --path %s\n' "$file"
    printf '  4. If the match is a known false positive, add an entry to:\n'
    printf '       %s\n' "$ALLOWLIST_FILE"
    printf '\n'
    printf 'Override (not recommended):  %sgit commit --no-verify%s\n' "$C_DIM" "$C_RESET"
}

# ----------------------------------------------------------------------------
# main_scan
#   Returns 0 if clean, 1 if blocked, 2 on internal error.
# ----------------------------------------------------------------------------
main_scan() {
    # Staged file list (Added / Copied / Modified)
    staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null) || {
        printf '%s[Credential Guard] git diff failed; allowing commit (fail-open)%s\n' "$C_YELLOW" "$C_RESET" >&2
        return 2
    }
    [ -z "$staged" ] && return 0

    # Build a binary-file set once
    binary_files=$(git diff --cached --numstat 2>/dev/null | awk '$1=="-" && $2=="-" {print $3}')

    # Build a set of staged paths (for path-level allowlist pre-check)
    blocked_count=0
    file_hits_total=0
    pass_count=0
    any_block=0
    block_summary=''

    for file in $staged; do
        # Path-level allowlist: a path: rule bypasses ALL checks for this
        # file (path-block AND content-scan). The hook's own source files
        # use this so they can contain example secrets / pattern strings.
        if path_allowlisted "$file"; then
            pass_count=$((pass_count + 1))
            continue
        fi

        # Path-level block: secret-bearing filenames
        if path_blocked "$file"; then
            any_block=1
            blocked_count=$((blocked_count + 1))
            block_summary="${block_summary}PATH|${file}||.env/.pem/.key/secrets file path blocked
"
            continue
        fi

        # Skip binary files
        case "$binary_files" in
            *"$file"*) continue ;;
        esac

        # Skip files that exceed the size cap (avoid grep stalls)
        size=$(git diff --cached --numstat -- "$file" 2>/dev/null | awk 'NR==1 {print $1}')
        case $size in
            -) : ;;  # binary — already handled
            *)
                if [ "${size:-0}" -gt 1000 ] 2>/dev/null; then
                    # > 1000 lines; let it through but we still scan
                    :
                fi
                ;;
        esac

        hits=$(scan_file "$file")
        if [ -z "$hits" ]; then
            pass_count=$((pass_count + 1))
            continue
        fi

        # Filter out hits that the allowlist whitelists
        filtered_hits=''
        filtered_count=0
        while IFS=$(printf '\t') read -r lineno label matched; do
            [ -z "$lineno" ] && continue
            # Reconstruct the line we saw (we only have matched substring)
            # so we can test the allowlist against the actual line content.
            # To do that we need to re-read the file at that line.
            full_line=$(git show ":$file" 2>/dev/null | sed -n "${lineno}p")
            if content_allowlisted "$full_line"; then
                continue
            fi
            filtered_hits="${filtered_hits}${lineno}	${label}	${matched}
"
            filtered_count=$((filtered_count + 1))
        done <<EOF
$hits
EOF

        if [ "$filtered_count" -gt 0 ]; then
            any_block=1
            blocked_count=$((blocked_count + 1))
            file_hits_total=$((file_hits_total + filtered_count))
            report_hits "$file" "$filtered_hits"
        else
            pass_count=$((pass_count + 1))
        fi
    done

    if [ "$any_block" -eq 1 ]; then
        printf '\n'
        printf '%sCredential Guard:%s %d file(s) blocked, %d file(s) clean\n' "$C_BOLD" "$C_RESET" "$blocked_count" "$pass_count"
        printf '%sExit code: 1 (commit blocked)%s\n' "$C_RED" "$C_RESET"
        return 1
    fi

    printf '%sCredential Guard:%s %d file(s) scanned, 0 secret(s) detected\n' "$C_GREEN" "$C_RESET" "$pass_count"
    return 0
}

# ----------------------------------------------------------------------------
# self_test
#   Run a battery of positive (must match) and negative (must NOT match)
#   fixtures against the pattern engine. Exits 0 on full pass, 3 on any
#   failure. Useful after install to verify the hook is wired correctly.
# ----------------------------------------------------------------------------
self_test() {
    failures=0
    total=0

    printf '%s== Credential Guard self-test ==%s\n' "$C_BOLD" "$C_RESET"
    printf '\n%s-- positive fixtures (must match) --%s\n' "$C_CYAN" "$C_RESET"

    positives='openai_key:::const apiKey = "sk-Abcdefghijklmnopqrstuvwxyz1234567890ABCDEF";
openai_key:::sk-proj-Abcdefghijklmnopqrstuvwxyz1234567890ABCDEF
anthropic_key:::sk-ant-api03-Abcdefghijklmnopqrstuvwxyz1234
github_pat:::ghp_Abcdefghijklmnopqrstuvwxyz0123456789
github_oauth:::gho_Abcdefghijklmnopqrstuvwxyz0123456789
github_app:::ghu_Abcdefghijklmnopqrstuvwxyz0123456789
github_server:::ghs_Abcdefghijklmnopqrstuvwxyz0123456789
aws_access_key:::AKIAIOSFODNN7EXAMPLE
azure_storage_conn:::DefaultEndpointsProtocol=https;AccountName=foo;AccountKey=AbcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/
slack_token:::xoxb-1234567890-1234567890-Abcdefghij
stripe_key:::sk_test_Abcdefghijklmnopqrstuvwxyz12
stripe_key:::pk_live_Abcdefghijklmnopqrstuvwxyz12
google_api_key:::AIzaSyAbcdefghijklmnopqrstuvwxyz0123456789
sendgrid_api_key:::SG.AAAAAAAAAAAAAAAAAAAAAA.BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
jwt:::eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NSJ9.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQ
private_key_block:::-----BEGIN RSA PRIVATE KEY-----
private_key_block:::-----BEGIN OPENSSH PRIVATE KEY-----
private_key_block:::-----BEGIN PRIVATE KEY-----
private_key_block:::-----BEGIN ENCRYPTED PRIVATE KEY-----
password_assignment_lc:::password: "hunter2hunter"
password_assignment_lc:::password = "hunter2hunter"
password_assignment_uc:::PASSWORD = "hunter2hunter"
secret_assignment_lc:::api_key: "abcdef1234567890abcdef"
secret_assignment_camel:::const apiKey = "abcdefghijklmnop1234"
secret_assignment_uc:::SECRET_KEY = "abcdefghijklmnop1234"
secret_assignment_uc:::BEARER: "abcdefghijklmnop1234"'

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        expected=${line%%:::*}
        input=${line#*:::}
        got=$(match_line "$input")
        total=$((total + 1))
        if [ "$got" = "$expected" ]; then
            printf '  %s[ ok ]%s %-32s %s\n' "$C_GREEN" "$C_RESET" "$expected" "${input:0:50}"
        else
            printf '  %s[FAIL]%s %-32s expected=%s got=%s  | %s\n' "$C_RED" "$C_RESET" "$expected" "$expected" "${got:-<no-match>}" "${input:0:50}"
            failures=$((failures + 1))
        fi
    done <<EOF
$positives
EOF

    printf '\n%s-- negative fixtures (must NOT match) --%s\n' "$C_CYAN" "$C_RESET"

    negatives='const x = 42;
const greeting = "hello world";
const url = "https://api.openai.com/v1/chat";
const endpoint = "https://api.github.com/users/octocat";
const hash = "5f4dcc3b5aa765d61d8327deb882cf99";
const sha = "da39a3ee5e6b4b0d3255bfef95601890afd80709";
SELECT id, name FROM users WHERE password_hash = ?;
const PASSWORD_HASH = "bcrypt$2a$10$abcdefghijklmnopqrstuv";
const apiEndpoint = "https://api.openai.com/v1/chat/completions";
const note = "use env var OPENAI_API_KEY";
const note2 = "see https://github.com/user/repo for details";
// this is a comment about secrets and api keys
echo "Starting server on port 8080"
const colour = "#FF00FF";
-----BEGIN CERTIFICATE-----
-----BEGIN PUBLIC KEY-----'

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        got=$(match_line "$line")
        total=$((total + 1))
        if [ -z "$got" ]; then
            printf '  %s[ ok ]%s clean                              %s\n' "$C_GREEN" "$C_RESET" "${line:0:50}"
        else
            printf '  %s[FAIL]%s clean line matched: %s  | %s\n' "$C_RED" "$C_RESET" "$got" "${line:0:50}"
            failures=$((failures + 1))
        fi
    done <<EOF
$negatives
EOF

    printf '\n%s-- mask() --%s\n' "$C_CYAN" "$C_RESET"
    total=$((total + 1))
    m=$(mask "sk-proj-Abcdefghijklmnop")
    if [ "$m" = "sk-p...mnop" ]; then
        printf '  %s[ ok ]%s mask long  -> %s\n' "$C_GREEN" "$C_RESET" "$m"
    else
        printf '  %s[FAIL]%s mask long  -> %s (expected sk-p...mnop)\n' "$C_RED" "$C_RESET" "$m"
        failures=$((failures + 1))
    fi
    total=$((total + 1))
    m=$(mask "short")
    if [ "$m" = "***" ]; then
        printf '  %s[ ok ]%s mask short -> %s\n' "$C_GREEN" "$C_RESET" "$m"
    else
        printf '  %s[FAIL]%s mask short -> %s (expected ***)\n' "$C_RED" "$C_RESET" "$m"
        failures=$((failures + 1))
    fi

    printf '\n%s-- path_allowlisted() --%s\n' "$C_CYAN" "$C_RESET"
    ALLOW_PATHS='docs/**/*.md
**/samples/**
**/*.example.json
tests/**'
    total=$((total + 1))
    pass=true
    for case in "docs/foo/bar.md:allow" \
                "docs/foo.md:allow" \
                "samples/x.json:allow" \
                "a/b/samples/y.txt:allow" \
                "a/b/c.example.json:allow" \
                "tests/unit/x.cs:allow" \
                "tests/foo.md:allow" \
                "src/foo.cs:block"; do
        f=${case%:*}
        expected=${case##*:}
        if path_allowlisted "$f"; then
            actual=allow
        else
            actual=block
        fi
        if [ "$actual" != "$expected" ]; then
            printf '  %s[FAIL]%s path_allowlisted(%s) expected=%s got=%s\n' \
                "$C_RED" "$C_RESET" "$f" "$expected" "$actual"
            pass=false
        fi
    done
    if [ "$pass" = true ]; then
        printf '  %s[ ok ]%s all 8 glob cases matched expectations\n' "$C_GREEN" "$C_RESET"
    else
        failures=$((failures + 1))
    fi
    ALLOW_PATHS=''

    printf '\n'
    if [ "$failures" -eq 0 ]; then
        printf '%sAll %d self-test checks passed.%s\n' "$C_GREEN" "$total" "$C_RESET"
        return 0
    else
        printf '%s%d of %d self-test checks FAILED.%s\n' "$C_RED" "$failures" "$total" "$C_RESET"
        return 3
    fi
}

# ----------------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------------
case ${1:-} in
    --self-test|self-test|-t)
        self_test
        exit $?
        ;;
    --help|-h|"")
        # Empty argv when run as a hook — proceed to scan.
        if [ -z "${1:-}" ]; then
            load_allowlist
            main_scan
            exit $?
        fi
        cat <<USAGE
Credential Guard — pre-commit hook

Usage:
  scripts/hooks/credential-guard           run as a git hook (no args)
  scripts/hooks/credential-guard --self-test
                                            run the in-process test suite
  scripts/hooks/credential-guard --help     show this help

This script is read-only by design. It never modifies files, refs, or
the working tree. To bypass for a single commit (not recommended):

    git commit --no-verify

Allowlist: $ALLOWLIST_FILE
USAGE
        exit 0
        ;;
    *)
        printf 'Unknown argument: %s\n' "$1" >&2
        exit 2
        ;;
esac
